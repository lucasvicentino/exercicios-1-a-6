{
  "name": "exercicios-configuracao-env",
  "version": "1.0.0",
  "private": true,
  "description": "Exercicios de configuracao segura e validacao de variaveis de ambiente",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "start:dev": "cross-env NODE_ENV=development tsx src/index.ts",
    "test": "npm run build && node --test tests/*.test.cjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "joi": "^17.13.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
